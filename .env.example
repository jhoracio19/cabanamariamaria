# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube al repositorio (ver .gitignore).

# Token que te da Vercel al crear un Blob store en:
# Dashboard del proyecto -> Storage -> Create Database -> Blob
BLOB_READ_WRITE_TOKEN=

# Clave aleatoria usada para firmar la sesión del panel de administración.
# Genera una nueva con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Cuentas del panel de invitaciones (/admin). Es un arreglo JSON como texto:
# [{"email":"correo@ejemplo.com","passwordHash":"$2b$10$..."}]
# El passwordHash se genera con bcrypt, nunca se guarda la contraseña en texto plano.
ADMIN_USERS_JSON=
